# Скопируйте этот файл в .env на сервере и заполните значения.
# Файл .env в git не попадает.
#
# Заявка с сайта отправляется письмом через SMTP на тот же почтовый ящик,
# с которого письмо отправлено (как в проекте shlif).
# Для mail.ru: зайдите в настройки почты → "Пароли для внешних приложений" →
# создайте пароль специально для сайта (обычный пароль от почты не подойдёт).

SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=k.antonov_prosto.ok@mail.ru
SMTP_PASS=
SMTP_FROM=k.antonov_prosto.ok@mail.ru

# Куда падают заявки (можно несколько адресов через запятую)
LEAD_MAIL_TO=k.antonov_prosto.ok@mail.ru

# Порт, на котором работает Next.js за nginx
PORT=3002
